# Streamlit dashboard (private on localhost:8601; fronted by Caddy on :8501).
# Ports/address come from .streamlit/config.toml.
[Unit]
Description=NCSA Research Computing Citation Tracker (Streamlit app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cheller
Group=cheller
WorkingDirectory=/home/cheller/gemini
EnvironmentFile=/home/cheller/gemini/.env
ExecStartPre=/home/cheller/gemini/venv/bin/python -m citation_tracker.cli init
ExecStart=/home/cheller/gemini/venv/bin/streamlit run app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
