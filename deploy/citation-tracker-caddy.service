# systemd unit for the Caddy TLS reverse proxy (durable HTTPS).
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo cp deploy/citation-tracker-caddy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now citation-tracker-caddy
[Unit]
Description=Caddy TLS reverse proxy for the NCSA Research Computing Citation Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
Restart=on-failure
RestartSec=5
# Allow binding 80/443 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Caddy stores certs/state here:
Environment=XDG_DATA_HOME=/var/lib

[Install]
WantedBy=multi-user.target
