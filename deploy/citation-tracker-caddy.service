# systemd unit for the Caddy TLS reverse proxy (durable HTTPS).
#
# NOTE: this host already runs a separate production Caddy for the Boneyard
# portal at /etc/caddy/Caddyfile (port 8247). Do NOT overwrite that file. This
# unit uses its own dedicated config + ports (80/443), so the two coexist.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/citation-tracker.Caddyfile
#   sudo cp deploy/citation-tracker-caddy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now citation-tracker-caddy
[Unit]
Description=Caddy TLS reverse proxy for the NCSA Research Computing Citation Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/citation-tracker.Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/citation-tracker.Caddyfile --force
Restart=on-failure
RestartSec=5
# Allow binding 80/443 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Caddy stores certs/state here:
Environment=XDG_DATA_HOME=/var/lib

[Install]
WantedBy=multi-user.target
