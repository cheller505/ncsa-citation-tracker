# Caddy HTTPS reverse proxy: serves https://warspite.ncsa.illinois.edu:8501
# (reusing the cached Let's Encrypt cert in /root/.local/share/caddy) and
# proxies to the Streamlit app on localhost:8601.
#
# NOTE: this host also runs a separate production Caddy for the Boneyard portal
# (/etc/caddy/Caddyfile, :8247). This unit uses its own config + ports, so the
# two coexist. Runs as root so it finds the existing cert storage.
[Unit]
Description=Caddy HTTPS reverse proxy for the NCSA Research Computing Citation Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/usr/local/bin/caddy run --config /home/cheller/gemini/deploy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /home/cheller/gemini/deploy/Caddyfile --force
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
