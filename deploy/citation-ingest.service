# Oneshot automatic discovery run, triggered by citation-ingest.timer.
[Unit]
Description=NCSA Citation Tracker - scheduled discovery pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cheller
Group=cheller
WorkingDirectory=/home/cheller/gemini
EnvironmentFile=/home/cheller/gemini/.env
ExecStart=/home/cheller/gemini/venv/bin/python -m citation_tracker.cli discover
