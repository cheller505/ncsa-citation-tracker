# Copy to .env and fill in. The .env file is gitignored.
# All values have sensible defaults except CONTACT_EMAIL and LLM_API_KEY.

# REQUIRED for Unpaywall + the Crossref "polite pool". Use a real address.
CONTACT_EMAIL=you@illinois.edu

# --- LLM evaluation backend (OpenAI-compatible chat completions) ---
# Set LLM_ENABLED=false to run with the transparent keyword heuristic only.
LLM_ENABLED=true
LLM_BASE_URL=https://lumen.ncsa.illinois.edu/v1
LLM_MODEL=nemotron-3-super-120b-a12b
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000

# --- Chat assistant (cheaper model, scoped strictly to project data) ---
CHAT_ENABLED=true
CHAT_MODEL=gemma-4-31b-it
CHAT_MAX_ROWS=400

# --- Automatic discovery ---
# Comma-separated search queries run against OpenAlex + Crossref.
DISCOVERY_QUERIES=NCSA Delta supercomputer,DeltaAI NCSA GPU,NCSA Delta GPU cluster,OAC-2005572,OAC-2320345
DISCOVERY_LIMIT=12
INGEST_INTERVAL_HOURS=12

# --- Storage ---
# Absolute path strongly recommended for systemd/cron/Docker deployments.
CITATION_DB_PATH=/var/lib/citation-tracker/citations.db

# --- Target identifiers (comma-separated where applicable) ---
TARGET_AWARDS=OAC-2005572,OAC-2320345
INSTITUTION_ROR=https://ror.org/047426m28
# INSTITUTION_NAMES=University of Illinois Urbana-Champaign,UIUC

# --- HTTP behaviour ---
HTTP_TIMEOUT=20
HTTP_RETRIES=3

# --- Optional fallback source (off by default) ---
ENABLE_DUCKDUCKGO=false

LOG_LEVEL=INFO
