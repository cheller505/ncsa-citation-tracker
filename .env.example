# Copy to .env and fill in. The .env file is gitignored.
# All values have sensible defaults except CONTACT_EMAIL and LLM_API_KEY.

# REQUIRED for Unpaywall + the Crossref "polite pool". Use a real address.
CONTACT_EMAIL=you@illinois.edu

# --- LLM evaluation backend (OpenAI-compatible chat completions) ---
# Point this at your locally-hosted NCSA LLM endpoint (OpenAI-compatible).
# Set LLM_ENABLED=false to run with the transparent keyword heuristic only.
LLM_ENABLED=true
LLM_BASE_URL=https://your-ncsa-llm-host/v1
LLM_MODEL=nemotron-3-super-120b-a12b
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000

# --- Evaluation mode: 'quorum' (multi-model board) or 'single' ---
# Quorum runs EVAL_MODELS in parallel; confidence = inter-model agreement.
EVAL_MODE=quorum
EVAL_MODELS=nemotron-3-super-120b-a12b,gemma-4-31b-it,qwen3-coder-next
EVAL_QUORUM=2
EVAL_MIN_RESPONDERS=2

# Local fallback board (e.g. Ollama on the same host): if the primary endpoint
# is down, each board seat drops to the positionally-paired local model.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_TIMEOUT=300
# EVAL_FALLBACK_MODELS=qwen2.5:3b,llama3.2:3b,gemma2:2b
# CHAT_FALLBACK_MODEL=qwen2.5:3b

# --- Site branding (sticker + About page). Generic if unset. ---
# SERVICE_NAME=your LLM service name
# SERVICE_URL=https://your-llm-service/

# --- Chat assistant (cheaper model, scoped strictly to project data) ---
CHAT_ENABLED=true
CHAT_MODEL=gemma-4-31b-it
CHAT_MAX_ROWS=400

# --- Automatic discovery ---
# By default, queries + tracked awards come from the systems registry
# (citation_tracker/systems.py). Override the whole registry with a JSON file:
# SYSTEMS_FILE=/etc/citation-tracker/systems.json
# Or override just the discovery queries (comma-separated):
# DISCOVERY_QUERIES=NCSA Delta supercomputer,NCSA Nightingale HPC,NCSA Radiant cloud
DISCOVERY_LIMIT=12
INGEST_INTERVAL_HOURS=12

# --- Semantic Scholar (optional API key lifts rate limits) ---
S2_API_KEY=

# --- Google Scholar Alert email ingestion (IMAP, optional) ---
# Point this at the mailbox that receives your Scholar alert emails.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_MARK_SEEN=true

# --- Zotero sync (optional) ---
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_COLLECTION=

# --- Backups ---
BACKUP_DIR=./backups

# --- Storage ---
# Absolute path strongly recommended for systemd/cron/Docker deployments.
CITATION_DB_PATH=/var/lib/citation-tracker/citations.db

# --- Target identifiers (comma-separated where applicable) ---
TARGET_AWARDS=OAC-2005572,OAC-2320345
INSTITUTION_ROR=https://ror.org/047426m28
# INSTITUTION_NAMES=University of Illinois Urbana-Champaign,UIUC

# --- HTTP behaviour ---
HTTP_TIMEOUT=20
HTTP_RETRIES=3

# --- Optional fallback source (off by default) ---
ENABLE_DUCKDUCKGO=false

LOG_LEVEL=INFO
